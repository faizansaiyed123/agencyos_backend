# Copy to .env for local development. Never commit real secrets.
AGENCYOS_ENV=dev
# Application connects as a NON-owner role so Row-Level Security is enforced.
AGENCYOS_DATABASE_URL=postgresql+psycopg://agencyos_app:agencyos_app@localhost:5432/agencyos
# Alembic connects as the schema owner.
AGENCYOS_MIGRATION_DATABASE_URL=postgresql+psycopg://agencyos:agencyos@localhost:5432/agencyos
# Required (>=32 chars) when AGENCYOS_ENV=prod
AGENCYOS_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
AGENCYOS_CORS_ORIGINS=["http://localhost:5173"]

# --- added with projects/billing/files/observability ---
# Where uploaded files live (local disk). Mount a persistent volume here in production.
AGENCYOS_STORAGE_DIR=./var/files
AGENCYOS_MAX_UPLOAD_BYTES=20971520
# Tracing is off by default. To enable, set OTEL_ENABLED=true and either leave the console
# exporter or point OTLP at a collector.
AGENCYOS_OTEL_ENABLED=false
AGENCYOS_OTEL_EXPORTER=console
# AGENCYOS_OTEL_OTLP_ENDPOINT=http://collector:4318/v1/traces

# --- transactional email ---
# Development can keep console; production validation requires smtp.
AGENCYOS_EMAIL_BACKEND=console
# AGENCYOS_SMTP_HOST=smtp.example.com
AGENCYOS_SMTP_PORT=587
# AGENCYOS_SMTP_USERNAME=...
# AGENCYOS_SMTP_PASSWORD=...
AGENCYOS_SMTP_FROM_EMAIL=noreply@example.com
AGENCYOS_SMTP_STARTTLS=true
AGENCYOS_PASSWORD_RESET_TTL_MINUTES=30
